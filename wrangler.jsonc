{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "florilegium-census",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "LIBRARY_BUCKET",
      "bucket_name": "sacrum-assets"
    }
  ]
}
